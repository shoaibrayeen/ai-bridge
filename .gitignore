# --- Java / Maven ---
target/
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*
replay_pid*

# --- IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr
out/

# --- Eclipse ---
.classpath
.project
.settings/

# --- VS Code / Cursor ---
.vscode/
.cursor/

# --- Node / Angular ---
node_modules/
frontend/dist/
frontend/.angular/
frontend/.sass-cache/

# --- Quarkus bundled frontend output ---
src/main/resources/META-INF/resources/

# --- OS files ---
.DS_Store
Thumbs.db

# --- Environment / secrets ---
# .env holds real credentials and must never be committed. .env.example is the
# committed template and is the only exception.
.env
.env.*
*.env
!.env.example
!.env.example.*

# Credential material of any kind
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets.json
credentials.json
