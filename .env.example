# ---------------------------------------------------------------------------
# AIBridge environment configuration
#
# Copy to `.env` and adjust:   cp .env.example .env
#
# The file is read in two places:
#   1. Quarkus picks up a `.env` in the working directory as a config source
#      (ordinal 295 — it overrides application.properties), so `mvn quarkus:dev`
#      and `java -jar target/quarkus-app/quarkus-run.jar` both honour it.
#   2. docker-compose.yml loads it via `env_file` for the `aibridge` service and
#      for the Postgres credentials.
#
# Naming rule: a Quarkus property maps to an env var by uppercasing it and
# replacing every non-alphanumeric character with `_`
# (quarkus.datasource.jdbc.url -> QUARKUS_DATASOURCE_JDBC_URL).
#
# `.env` is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Quarkus profile -------------------------------------------------------
# dev (default) | docker | prod
# docker-compose overrides this to `docker` for the containerised app.
QUARKUS_PROFILE=dev

# --- HTTP ------------------------------------------------------------------
QUARKUS_HTTP_PORT=8080
# Comma-separated list of allowed browser origins for the admin UI / playground.
QUARKUS_HTTP_CORS_ORIGINS=http://localhost:4200

# --- PostgreSQL ------------------------------------------------------------
# Host/port/db/user/password used by the `postgres` container in docker-compose.
POSTGRES_DB=aibridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# JDBC URL used by the application.
# Local run (backend on the host, Postgres in Docker):
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/aibridge
# Inside docker-compose the service name is used instead — compose sets
# jdbc:postgresql://postgres:5432/aibridge for the aibridge container.
QUARKUS_DATASOURCE_USERNAME=postgres
QUARKUS_DATASOURCE_PASSWORD=postgres

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6379
# Only required when CACHE_MODE=redis.
QUARKUS_REDIS_HOSTS=redis://localhost:6379

# --- Cache mode ------------------------------------------------------------
# in-memory (default, single instance) | redis (required for multi-instance
# deployments so pacing and auth tokens are shared)
CACHE_MODE=in-memory

# --- Security --------------------------------------------------------------
# AES-256 key — MUST be exactly 32 characters. Generate one with:
#   openssl rand -base64 32 | cut -c1-32
AIBRIDGE_ENCRYPTION_KEY=CHANGE_ME_IN_PRODUCTION_32CHARS!

# Static API key exchanged for a bearer token at POST /api/auth/token.
AIBRIDGE_AUTH_API_KEY=CHANGE_ME_IN_PRODUCTION
AIBRIDGE_AUTH_TOKEN_VALIDITY_MINUTES=60

# Allow plain-HTTP provider endpoints. Keep false outside local development.
AIBRIDGE_ENDPOINT_ALLOW_HTTP=true

# SSRF allowlist — comma-separated host patterns the gateway may call.
AIBRIDGE_ALLOWED_PROVIDER_HOSTS=api.openai.com,api.anthropic.com,api.cerebras.ai,bedrock-runtime.*.amazonaws.com,*.cloud.ibm.com

# --- Request pacing / load testing -----------------------------------------
AIBRIDGE_QUEUE_TIMEOUT_MS=5000
AIBRIDGE_QUEUE_POLL_INTERVAL_MS=50
AIBRIDGE_QUEUE_MAX_DEPTH=1000
AIBRIDGE_LOAD_TEST_MAX_PARALLEL=500

# --- UI --------------------------------------------------------------------
# false serves the API only (no Angular bundle, no SPA routing).
UI_REQUIRED=true

# --- Logging ---------------------------------------------------------------
AIBRIDGE_LOG_LEVEL=INFO
AIBRIDGE_LOG_APP_LEVEL=DEBUG
